{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "bash \"${CURSOR_PLUGIN_ROOT}/hooks/run_gate.sh\" cursor audit_gate.py"
      }
    ],
    "preToolUse": [
      {
        "matcher": "Write",
        "command": "bash \"${CURSOR_PLUGIN_ROOT}/hooks/run_gate.sh\" cursor deliberate_gate.py"
      }
    ]
  }
}
